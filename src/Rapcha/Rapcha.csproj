<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Rapcha</AssemblyName>
    <RootNamespace>Rapcha</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rapcha.ico</ApplicationIcon>
    <StartupObject>Rapcha.Win.Program</StartupObject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Rapcha</Product>
    <AssemblyTitle>Rapcha - voice typing for Windows</AssemblyTitle>
    <Company>Prince Nii Thompson</Company>
    <Copyright>Prince Nii Thompson</Copyright>
    <Version>1.0.0</Version>
    <Version Condition="'$(RAPCHA_BUILD)' != ''">1.0.$(RAPCHA_BUILD)</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Compile-time projections for the built-in Windows OCR engine (Windows.Media.Ocr); nothing is shipped. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Speech" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\lifebuoy.png" LogicalName="Rapcha.lifebuoy.png" />
    <EmbeddedResource Include="Assets\rapcha.ico" LogicalName="Rapcha.rapcha.ico" />
    <!-- The whisper.cpp engine (two 32-bit builds of native/rapcha-whisper.dll, gzipped). The release workflow builds
         them into Assets\engine before this project; a local build without them simply has no Whisper inside. -->
    <EmbeddedResource Include="Assets\engine\*.dll.gz" LogicalName="Rapcha.engine.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
